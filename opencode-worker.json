{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "worker": {
      "description": "Worker for a bounded coding, review, or research task. Supply the outcome, write boundary, and acceptance criteria.",
      "mode": "subagent",
      "permission": {
        "task": "deny",
        "bash": {
          "git commit *": "ask",
          "git push *": "deny",
          "git reset *": "ask",
          "git checkout *": "ask",
          "git restore *": "ask",
          "git stash *": "ask",
          "git clean *": "deny"
        }
      },
      "prompt": "{file:../../.agents/skills/ponytail-caveman-subagent/references/worker-instructions.md}"
    }
  }
}
